# Copy this file to `.env` and fill in the real values.
# The real `.env` is gitignored — never commit it.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/issuedb?schema=public"

# Secret used to sign JWT access tokens.
# Generate a long random string, e.g.:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# HTTP port (optional — defaults to 3000)
PORT=3000

# Default password applied by the admin "reset password" endpoint.
# NOTE: the variable name is misspelled ("SECRETE") in the code.
# It must be spelled exactly like this for the endpoint to read it.
SECRETE_RESET_PASSWORD="replace-with-a-secure-default-password"
